{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dataset Mixer",
  "version": "0.1.0",
  "identifier": "dev.datasetmixer.app",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../ui run dev",
    "beforeBuildCommand": "npm --prefix ../ui run build"
  },
  "app": {
    "windows": [
      { "title": "Dataset Mixer", "width": 1320, "height": 880, "minWidth": 920, "minHeight": 620 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
